<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Order Details</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa;
    }
    .page-header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 40px 0;
      margin-bottom: 30px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    .page-header h1 {
      font-weight: 700;
      margin: 0;
    }
    .back-button {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #667eea;
      text-decoration: none;
      font-weight: 500;
      margin-bottom: 20px;
    }
    .back-button:hover {
      color: #764ba2;
      transform: translateX(-5px);
    }
    .order-section {
      background: white;
      border-radius: 12px;
      padding: 30px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      margin-bottom: 30px;
    }
    .section-title {
      font-size: 20px;
      font-weight: 700;
      color: #333;
      margin-bottom: 25px;
      padding-bottom: 15px;
      border-bottom: 3px solid #667eea;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .section-title i {
      color: #667eea;
    }
    .summary-card {
      background: #f8f9fa;
      border-radius: 10px;
      padding: 20px;
      border-left: 4px solid #667eea;
      margin-bottom: 15px;
    }
    .summary-label {
      font-size: 12px;
      color: #999;
      text-transform: uppercase;
      font-weight: 600;
      margin-bottom: 8px;
    }
    .summary-value {
      font-size: 18px;
      font-weight: 700;
      color: #333;
    }
    .items-table {
      width: 100%;
      border-collapse: collapse;
    }
    .items-table thead th {
      background-color: #f8f9fa;
      border-bottom: 2px solid #dee2e6;
      font-weight: 600;
      color: #667eea;
      padding: 15px;
      text-align: left;
    }
    .items-table tbody td {
      padding: 15px;
      vertical-align: middle;
      border-bottom: 1px solid #dee2e6;
    }
    .price-value {
      color: #667eea;
      font-weight: 600;
    }
    .refund-section {
      background-color: #fff3cd;
      padding: 20px;
      border-radius: 8px;
      border-left: 4px solid #ffc107;
      margin-top: 20px;
    }
    .refund-button {
      margin-top: 10px;
    }
    .payment-badge {
      display: inline-block;
      padding: 6px 16px;
      border-radius: 20px;
      font-size: 0.9rem;
      background-color: #003087;
      color: white;
    }
  </style>
</head>
<body>
<%- include('partials/navbar', { user: user }) %>

<div class="page-header">
  <div class="container">
    <h1><i class="fas fa-receipt"></i> Order #<%= order.id %></h1>
  </div>
</div>

<main class="container my-4">
  <a href="<%= user.role === 'admin' ? '/admin/orders' : '/orders' %>" class="back-button">
    <i class="fas fa-arrow-left"></i> Back
  </a>

  <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

  <div class="row">
    <div class="col-md-8">
      <!-- Order Summary Cards -->
      <div class="order-section">
        <div class="summary-card">
          <div class="summary-label">Order Date</div>
          <div class="summary-value"><%= new Date(order.created_at).toLocaleString() %></div>
        </div>
        <div class="summary-card">
          <div class="summary-label">Customer</div>
          <div class="summary-value"><%= order.username %> (<%=order.email %>)</div>
        </div>
        <% if (user.role === 'admin') { %>
          <div class="summary-card">
            <div class="summary-label">Status</div>
            <form method="POST" action="/admin/orders/<%= order.id %>/status" class="d-inline">
              <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="Placed" <%= order.status === 'Placed' ? 'selected' : '' %>>Placed</option>
                <option value="Processing" <%= order.status === 'Processing' ? 'selected' : '' %>>Processing</option>
                <option value="Shipped" <%= order.status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                <option value="Delivered" <%= order.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                <option value="Cancelled" <%= order.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
              </select>
            </form>
          </div>
        <% } %>
      </div>

      <!-- Order Items -->
      <div class="order-section">
        <div class="section-title">
          <i class="fas fa-shopping-bag"></i> Items
        </div>
        <table class="items-table">
          <thead>
            <tr>
              <th style="width: 50%;">Product</th>
              <th style="width: 15%;">Price</th>
              <th style="width: 15%;">Qty</th>
              <th style="width: 20%; text-align: right;">Subtotal</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(function(it) { %>
              <tr>
                <td><%= it.productName || ('Product #' + it.product_id) %></td>
                <td><span class="price-value">$<%= Number(it.price).toFixed(2) %></span></td>
                <td><%= it.quantity %></td>
                <td style="text-align: right;"><strong>$<%= (Number(it.price) * it.quantity).toFixed(2) %></strong></td>
              </tr>
            <% }) %>
            <tr style="border-top: 2px solid #dee2e6;">
              <td colspan="3" style="text-align: right;"><strong>Total:</strong></td>
              <td style="text-align: right;"><strong class="price-value" style="font-size: 18px;">$<%= Number(order.total).toFixed(2) %></strong></td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Payment Information -->
      <div class="order-section">
        <div class="section-title">
          <i class="fas fa-credit-card"></i> Payment
        </div>
        <% if (order.paypal_capture_id) { %>
          <p>
            <span class="payment-badge"><i class="fab fa-paypal"></i> PayPal</span>
          </p>
          <p class="text-muted small"><strong>Transaction ID:</strong> <%= order.paypal_capture_id %></p>
          
          <% if (order.refund_id) { %>
            <div class="alert alert-info">
              <i class="fas fa-check-circle"></i> <strong>Refund Processed</strong>
              <br><small>Refund ID: <%= order.refund_id %></small>
              <br><small>Status: <span class="badge bg-success"><%= order.refund_status %></span></small>
            </div>
          <% } else if (user.role === 'admin') { %>
            <div class="refund-section">
              <h6 class="mb-3"><i class="fas fa-undo"></i> Process Refund</h6>
              <p class="small text-muted mb-3">Issue a refund for this PayPal transaction. Leave amount empty for full refund.</p>
              
              <form id="refundForm">
                <div class="mb-3">
                  <label for="refundAmount" class="form-label">Refund Amount</label>
                  <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="number" class="form-control" id="refundAmount" step="0.01" min="0" max="<%= Number(order.total).toFixed(2) %>" placeholder="Leave empty for full refund">
                  </div>
                  <small>Max: $<%= Number(order.total).toFixed(2) %></small>
                </div>
                <button type="submit" class="btn btn-warning refund-button">
                  <i class="fas fa-undo"></i> Process Refund
                </button>
              </form>
            </div>
          <% } %>
        <% } else { %>
          <p class="text-muted">No payment information available</p>
        <% } %>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="col-md-4">
      <div class="order-section">
        <div class="section-title">
          <i class="fas fa-list-check"></i> Summary
        </div>
        <div class="summary-card">
          <div class="summary-label">Order ID</div>
          <div class="summary-value">#<%= order.id %></div>
        </div>
        <div class="summary-card">
          <div class="summary-label">Total Amount</div>
          <div class="summary-value" style="font-size: 22px; color: #667eea;">$<%= Number(order.total).toFixed(2) %></div>
        </div>
        <% if (order.refund_id) { %>
          <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> Refunded
          </div>
        <% } %>
        <a href="<%= user.role === 'admin' ? '/admin/orders' : '/orders' %>" class="btn btn-secondary w-100">
          Back to Orders
        </a>
      </div>
    </div>
  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const refundForm = document.getElementById('refundForm');
  if (refundForm) {
    refundForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const refundBtn = refundForm.querySelector('button[type="submit"]');
      const refundAmount = document.getElementById('refundAmount').value;
      
      if (!confirm('Are you sure you want to process this refund?')) return;
      
      refundBtn.disabled = true;
      refundBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

      try {
        const response = await fetch('/api/paypal/refund', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            captureId: '<%= order.paypal_capture_id %>',
            amount: refundAmount || null,
            orderId: <%= order.id %>
          })
        });

        const data = await response.json();

        if (response.ok) {
          alert('✓ Refund processed successfully!\nRefund ID: ' + data.refundId);
          location.reload();
        } else {
          alert('✗ Refund failed:\n' + (data.message || data.error));
        }
      } catch (err) {
        alert('✗ Error: ' + err.message);
      } finally {
        refundBtn.disabled = false;
        refundBtn.innerHTML = '<i class="fas fa-undo"></i> Process Refund';
      }
    });
  }
</script>
</body>
</html>
